---
import { storyData } from '../data/story';

const { reasons } = storyData;
---

<section id="razones" class="py-20 px-4 sm:px-6 lg:px-8 relative z-10">
  <div class="max-w-5xl mx-auto">
    
    <!-- Encabezado -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs uppercase tracking-[0.3em] text-romance-rose font-medium block mb-2">
        Mis Latidos
      </span>
      <h2 class="font-serif text-3xl sm:text-5xl text-white font-normal mb-4">
        {reasons.title}
      </h2>
      <p class="text-sm sm:text-base text-romance-blush/70 font-light">
        {reasons.subtitle}
      </p>
    </div>

    <!-- Grid de Razones -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        reasons.items.map((item, idx) => (
          <div class="reason-card group relative p-6 sm:p-7 rounded-2xl glass-panel border-romance-gold/15 hover:border-romance-gold/50 transition-all duration-500 hover:-translate-y-2 hover:shadow-glow-rose/20">
            <!-- Destello de fondo en hover -->
            <div class="absolute inset-0 bg-gradient-to-br from-romance-rose/10 via-transparent to-romance-gold/10 opacity-0 group-hover:opacity-100 rounded-2xl transition-opacity duration-500 pointer-events-none"></div>

            <!-- Número / Tag -->
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs uppercase tracking-widest px-3 py-1 rounded-full bg-romance-burgundy/40 text-romance-blush/90 border border-romance-rose/20 font-medium">
                {item.tag}
              </span>
              <span class="font-serif text-lg text-romance-gold/50 group-hover:text-romance-gold transition-colors">
                #0{idx + 1}
              </span>
            </div>

            <!-- Título del motivo -->
            <h3 class="font-serif text-xl sm:text-2xl text-white font-medium mb-3 group-hover:text-romance-blush transition-colors">
              {item.title}
            </h3>

            <!-- Descripción -->
            <p class="text-sm text-romance-pearl/75 font-light leading-relaxed">
              {item.description}
            </p>

            <!-- Pequeño corazón sutil al pie -->
            <div class="mt-4 pt-3 border-t border-white/5 flex justify-end">
              <span class="text-romance-rose/40 group-hover:text-romance-rose group-hover:scale-125 transition-all duration-300">
                ♥
              </span>
            </div>
          </div>
        ))
      }
    </div>

  </div>
</section>
