---
import { storyData } from '../data/story';

const { couple, counter } = storyData;
---

<section id="contador" class="py-20 px-4 sm:px-6 lg:px-8 relative z-10">
  <div class="max-w-4xl mx-auto text-center">
    
    <!-- Encabezado de la Sección -->
    <div class="inline-flex items-center justify-center p-3 rounded-full bg-romance-card/70 border border-romance-rose/20 mb-4 shadow-glow-rose/20">
      <svg class="w-6 h-6 text-romance-rose animate-pulse" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
    </div>

    <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-white font-normal mb-3">
      {counter.title}
    </h2>
    <p class="text-sm sm:text-base text-romance-blush/70 font-light max-w-lg mx-auto mb-10">
      {counter.subtitle} <strong class="text-romance-gold font-normal">{couple.anniversaryDateText}</strong>
    </p>

    <!-- Tarjetas de Contador en Tiempo Real -->
    <div
      id="live-counter-grid"
      data-start-date={couple.togetherSince}
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4 max-w-3xl mx-auto"
    >
      <!-- Años -->
      <div class="glass-panel p-4 sm:p-5 rounded-2xl flex flex-col items-center justify-center border-romance-gold/15 group hover:border-romance-gold/40 transition-all duration-300">
        <span id="counter-years" class="font-serif text-3xl sm:text-4xl text-romance-accent font-semibold tracking-tight">0</span>
        <span class="text-[11px] uppercase tracking-wider text-romance-pearl/70 font-light mt-1">Años</span>
      </div>

      <!-- Meses -->
      <div class="glass-panel p-4 sm:p-5 rounded-2xl flex flex-col items-center justify-center border-romance-gold/15 group hover:border-romance-gold/40 transition-all duration-300">
        <span id="counter-months" class="font-serif text-3xl sm:text-4xl text-romance-accent font-semibold tracking-tight">0</span>
        <span class="text-[11px] uppercase tracking-wider text-romance-pearl/70 font-light mt-1">Meses</span>
      </div>

      <!-- Días -->
      <div class="glass-panel p-4 sm:p-5 rounded-2xl flex flex-col items-center justify-center border-romance-gold/15 group hover:border-romance-gold/40 transition-all duration-300">
        <span id="counter-days" class="font-serif text-3xl sm:text-4xl text-romance-accent font-semibold tracking-tight">0</span>
        <span class="text-[11px] uppercase tracking-wider text-romance-pearl/70 font-light mt-1">Días</span>
      </div>

      <!-- Horas -->
      <div class="glass-panel p-4 sm:p-5 rounded-2xl flex flex-col items-center justify-center border-romance-gold/15 group hover:border-romance-gold/40 transition-all duration-300">
        <span id="counter-hours" class="font-serif text-3xl sm:text-4xl text-romance-rose font-semibold tracking-tight">0</span>
        <span class="text-[11px] uppercase tracking-wider text-romance-pearl/70 font-light mt-1">Horas</span>
      </div>

      <!-- Minutos -->
      <div class="glass-panel p-4 sm:p-5 rounded-2xl flex flex-col items-center justify-center border-romance-gold/15 group hover:border-romance-gold/40 transition-all duration-300">
        <span id="counter-minutes" class="font-serif text-3xl sm:text-4xl text-romance-rose font-semibold tracking-tight">0</span>
        <span class="text-[11px] uppercase tracking-wider text-romance-pearl/70 font-light mt-1">Minutos</span>
      </div>

      <!-- Segundos -->
      <div class="glass-panel p-4 sm:p-5 rounded-2xl flex flex-col items-center justify-center border-romance-gold/15 group hover:border-romance-gold/40 transition-all duration-300">
        <span id="counter-seconds" class="font-serif text-3xl sm:text-4xl text-romance-blush font-semibold tracking-tight">0</span>
        <span class="text-[11px] uppercase tracking-wider text-romance-pearl/70 font-light mt-1">Segundos</span>
      </div>
    </div>

    <!-- Mensaje inspirador complementario -->
    <p class="mt-8 text-xs sm:text-sm text-romance-blush/60 italic font-serif">
      "Y si volviera a empezar, te elegiría mil veces más sin dudarlo ni un instante."
    </p>
  </div>
</section>

<script>
  function initLiveCounter() {
    const grid = document.getElementById('live-counter-grid');
    if (!grid) return;

    const startDateStr = grid.dataset.startDate || '2023-02-14T20:00:00';
    const startDate = new Date(startDateStr);

    const elYears = document.getElementById('counter-years');
    const elMonths = document.getElementById('counter-months');
    const elDays = document.getElementById('counter-days');
    const elHours = document.getElementById('counter-hours');
    const elMinutes = document.getElementById('counter-minutes');
    const elSeconds = document.getElementById('counter-seconds');

    function updateCounter() {
      const now = new Date();
      if (now < startDate) {
        // En caso de fecha futura
        if (elDays) elDays.textContent = '0';
        return;
      }

      // Cálculo de desglose de calendario
      let years = now.getFullYear() - startDate.getFullYear();
      let months = now.getMonth() - startDate.getMonth();
      let days = now.getDate() - startDate.getDate();
      let hours = now.getHours() - startDate.getHours();
      let minutes = now.getMinutes() - startDate.getMinutes();
      let seconds = now.getSeconds() - startDate.getSeconds();

      if (seconds < 0) {
        seconds += 60;
        minutes--;
      }
      if (minutes < 0) {
        minutes += 60;
        hours--;
      }
      if (hours < 0) {
        hours += 24;
        days--;
      }
      if (days < 0) {
        const prevMonth = new Date(now.getFullYear(), now.getMonth(), 0);
        days += prevMonth.getDate();
        months--;
      }
      if (months < 0) {
        months += 12;
        years--;
      }

      if (elYears) elYears.textContent = String(years);
      if (elMonths) elMonths.textContent = String(months);
      if (elDays) elDays.textContent = String(days);
      if (elHours) elHours.textContent = String(hours).padStart(2, '0');
      if (elMinutes) elMinutes.textContent = String(minutes).padStart(2, '0');
      if (elSeconds) elSeconds.textContent = String(seconds).padStart(2, '0');
    }

    updateCounter();
    setInterval(updateCounter, 1000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLiveCounter);
  } else {
    initLiveCounter();
  }
</script>
