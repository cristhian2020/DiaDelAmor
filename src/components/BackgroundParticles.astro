---
// BackgroundParticles.astro: Fondo animado interactivo con pétalos sutiles y bokeh de luz dorada/rosada
---

<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
  <!-- Sutil gradiente de profundidad radial -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,29,57,0.25),rgba(8,3,6,0.95))] pointer-events-none"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_120%,rgba(74,17,34,0.3),rgba(8,3,6,0))] pointer-events-none"></div>

  <!-- Canvas para partículas y pétalos flotantes -->
  <canvas id="ambient-canvas" class="absolute inset-0 w-full h-full opacity-70"></canvas>
</div>

<script>
  function initAmbientParticles() {
    const canvas = document.getElementById('ambient-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      if (!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    interface Particle {
      x: number;
      y: number;
      size: number;
      speedX: number;
      speedY: number;
      opacity: number;
      color: string;
      rotation: number;
      rotationSpeed: number;
      isPetal: boolean;
      oscillation: number;
    }

    const particles: Particle[] = [];
    const colors = [
      'rgba(243, 198, 143, ',  // Oro sutil / champagne
      'rgba(212, 105, 125, ',  // Rose gold
      'rgba(252, 213, 206, ',  // Blush
      'rgba(250, 247, 242, ',  // Pearl
    ];

    const count = Math.min(Math.floor(window.innerWidth / 25), 45);

    for (let i = 0; i < count; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        size: Math.random() * 4 + 2,
        speedX: (Math.random() - 0.5) * 0.4 + 0.1,
        speedY: Math.random() * 0.6 + 0.3,
        opacity: Math.random() * 0.5 + 0.15,
        color: colors[Math.floor(Math.random() * colors.length)],
        rotation: Math.random() * 360,
        rotationSpeed: (Math.random() - 0.5) * 0.8,
        isPetal: Math.random() > 0.4,
        oscillation: Math.random() * Math.PI * 2,
      });
    }

    // Mouse subtle breeze effect
    let mouseX = width / 2;
    let mouseY = height / 2;
    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    function drawPetal(p: Particle, c: CanvasRenderingContext2D) {
      c.save();
      c.translate(p.x, p.y);
      c.rotate((p.rotation * Math.PI) / 180);
      c.beginPath();
      // Forma de pétalo curvo
      c.moveTo(0, 0);
      c.bezierCurveTo(-p.size * 1.5, -p.size * 2, -p.size * 2.5, p.size, 0, p.size * 2.5);
      c.bezierCurveTo(p.size * 2.5, p.size, p.size * 1.5, -p.size * 2, 0, 0);
      c.fillStyle = p.color + p.opacity + ')';
      c.fill();
      c.restore();
    }

    function drawLightOrb(p: Particle, c: CanvasRenderingContext2D) {
      c.save();
      c.beginPath();
      c.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      c.fillStyle = p.color + p.opacity + ')';
      c.shadowColor = p.color + '0.8)';
      c.shadowBlur = p.size * 3;
      c.fill();
      c.restore();
    }

    let animationFrameId: number;

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      particles.forEach((p) => {
        p.oscillation += 0.015;
        p.x += p.speedX + Math.sin(p.oscillation) * 0.4;
        p.y += p.speedY;
        p.rotation += p.rotationSpeed;

        // Mouse breeze reaction
        const dx = p.x - mouseX;
        const dy = p.y - mouseY;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 120) {
          p.x += (dx / dist) * 0.8;
          p.y += (dy / dist) * 0.8;
        }

        // Wrap around edges
        if (p.y > height + 20) {
          p.y = -20;
          p.x = Math.random() * width;
        }
        if (p.x > width + 20) p.x = -20;
        if (p.x < -20) p.x = width + 20;

        if (p.isPetal) {
          drawPetal(p, ctx);
        } else {
          drawLightOrb(p, ctx);
        }
      });

      animationFrameId = requestAnimationFrame(animate);
    }

    animate();
  }

  // Ejecutar al cargar la página
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAmbientParticles);
  } else {
    initAmbientParticles();
  }
</script>
